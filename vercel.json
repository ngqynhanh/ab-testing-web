{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/study.mjs": {
      "includeFiles": "data/tables.json",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {"source": "/api/:action", "destination": "/api/study?studyAction=:action"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' blob:; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'"}
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/stimuli/:file",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=86400"}
      ]
    }
  ]
}
